## Black Scholes Merton Model 
S = data["Close"][-1]
r = 0.0545
sigma = annualstd
maturities_days = [30,60,90]
maturities = [ d/365.0  for d in maturities_days]
strikes = [S*0.95, S*0.98,S, S*1.02, S*1.05]


import math
def bsm_d1_d2(S,K,T,r,sigma):
  d1 = (math.log(S/K) + (r + 0.5*sigma**2)*T) / (sigma * math.sqrt(T))
  d2 = d1 - sigma * math.sqrt(T)
  return d1,d2

def bsm_price(S,K,T,r, sigma, option_type):
  d1, d2 = bsm_d1_d2(S,K,T,r,sigma)
  if option_type == "call":
    return S*norm.cdf(d1) - K*math.exp(-r*T)*norm.cdf(d2)
  else:
    return -S*norm.cdf(-d1) + K*math.exp(-r*T)*norm.cdf(-d2)


rows = []

for K in strikes:
  for d,T in zip(maturities_days, maturities):
    call_price=bsm_price(S,K,T,r,sigma, 'call')
    put_price=bsm_price(S,K,T,r,sigma,'put')
  rows.append({
      'Spot': S,
      'Sigma_annual': sigma,
      'r_annual': r,
      'Strike': K,
      'Maturity_days': d,
      'Maturity_years': round(T,4),
      'Type': 'Put',
      'Price': round(put_price, 4),})
  rows.append({
      'Spot': S,
