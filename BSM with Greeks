## Option Greek 
S = data["Close"]
import math
from scipy.stats import norm

def _bsm_d1_d2(S,K,T,r,sigma):
  if T <= 0 or sigma <= 0:
    return (float("inf") if S>K else -float("inf")),  (float("inf") if S>K else float("inf"))

  part = sigma * math.sqrt(T)
  d1 = (math.log(S / K) + (r + 0.5 * sigma**2) * T) / part
  d2 = d1 - part
  return d1, d2


def bsm_price(S, K, r, sigma, T, option_type='call'):
    d1, d2 = _bsm_d1_d2(S, K, r, sigma, T)
    if str(option_type).lower().startswith('c'):
        return S * norm.cdf(d1) - K * math.exp(-r * T) * norm.cdf(d2)
    else:
        return K * math.exp(-r * T) * norm.cdf(-d2) - S * norm.cdf(-d1)

def greek_delta(S, K, r, sigma, T, option_type='call'):
    d1, _ = _bsm_d1_d2(S, K, r, sigma, T)
    return norm.cdf(d1) if str(option_type).lower().startswith('c') else (norm.cdf(d1) - 1.0)

def greek_gamma(S, K, r, sigma, T):
    d1, _ = _bsm_d1_d2(S, K, r, sigma, T)
    denom = S * sigma * math.sqrt(T) if (S > 0 and sigma > 0 and T > 0) else float('inf')
    return norm.pdf(d1) / denom

def greek_vega(S, K, r, sigma, T):
    d1, _ = _bsm_d1_d2(S, K, r, sigma, T)
    return S * norm.pdf(d1) * math.sqrt(T)   # per unit vol

def greek_theta_per_day(S, K, r, sigma, T, option_type='call', days_in_year=365.0):
    d1, d2 = _bsm_d1_d2(S, K, r, sigma, T)
    if T <= 0:
        return 0.0
    first = - (S * norm.pdf(d1) * sigma) / (2 * math.sqrt(T))
    if str(option_type).lower().startswith('c'):
        second = - r * K * math.exp(-r * T) * norm.cdf(d2)
    else:
        second = r * K * math.exp(-r * T) * norm.cdf(-d2)
    theta_annual = first + second
    return theta_annual / days_in_year

def greek_rho(S, K, r, sigma, T, option_type='call'):
    d1, d2 = _bsm_d1_d2(S, K, r, sigma, T)
    if str(option_type).lower().startswith('c'):
        return K * T * math.exp(-r * T) * norm.cdf(d2)
    else:
        return -K * T * math.exp(-r * T) * norm.cdf(-d2)
